{
  "info": {
    "name": "VCBS price board",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API công khai của bảng giá VCBS, không cần token. Socket.IO xem mục 'Socket.IO' (Postman: New > Socket.IO, client version v2)."
  },
  "variable": [
    {
      "key": "price",
      "value": "https://vcbsprice.vcbs.com.vn"
    },
    {
      "key": "api",
      "value": "https://vcbsapi.vcbs.com.vn"
    },
    {
      "key": "future",
      "value": "41I1GB000",
      "description": "mã phái sinh, lấy từ /pslistdata"
    },
    {
      "key": "symbol",
      "value": "HPG"
    },
    {
      "key": "indexCodes",
      "value": "10,11,02,03,31"
    },
    {
      "key": "indexCode",
      "value": "10"
    },
    {
      "key": "limit",
      "value": "200"
    },
    {
      "key": "page",
      "value": "1"
    }
  ],
