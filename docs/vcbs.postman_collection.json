    {
      "name": "Socket.IO (không import được, cấu hình tay)",
      "item": [
        {
          "name": "Hướng dẫn",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://vcbsprice.vcbs.com.vn/ps",
              "host": [
                "https://vcbsprice.vcbs.com.vn/ps"
              ]
            },
            "description": "Postman: New > Socket.IO. URL: wss://vcbsprice.vcbs.com.vn/ps (namespace /ps), client version v2, transport websocket.\nGửi event 'regs' (JSON string): {\"action\":\"join\",\"data\":\"41I1GB000,41I1GB000_LS,41I1GB000_NTP,41I1GB000_TP\"}\nPing mỗi 10s event 'regs': {\"action\":\"ping\",\"mode\":\"sync\",\"data\":\" \"}\nLắng nghe event 'public' => {\"data\":{...}}."
          }
        }
      ]
    },
